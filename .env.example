# ==========================================================
# CONFIGURACIÓN DE ENTORNO - REMESAS BITCOIN (EE.UU. -> SV)
# ==========================================================

# Modo de operación de pagos por defecto:
# - "mock": Simula saldos y pagos de Blink sin gastar dinero real (Desarrollo UI/DB)
# - "production": Conecta en vivo con Blink API Mainnet para enviar a Chivo Wallet
PAYMENT_MODE="mock"

# Blink GraphQL API (Producción: https://api.blink.sv/graphql)
BLINK_API_URL="https://api.blink.sv/graphql"

# Pega aquí tu API Key de Blink (con scopes READ, RECEIVE y WRITE)
BLINK_API_KEY=""

# Contraseña para acceder al panel administrativo privado (/admin)
ADMIN_PASSWORD="admin1234"

# Base de datos (PostgreSQL para despliegue en la nube / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remesas_sv?schema=public"
